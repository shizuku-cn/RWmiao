                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name=".app.IconThemeProvider"
            android:authorities="${applicationId}.icon-theme"
            android:exported="true"
            android:grantUriPermissions="false" />

        <receiver
            android:name=".app.ThemeSyncReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.shizuku.rwmiao.action.SYNC_THEME" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".app.ModuleActivationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.shizuku.rwmiao.action.MODULE_HEARTBEAT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
