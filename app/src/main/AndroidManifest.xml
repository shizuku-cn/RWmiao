            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".app.LauncherCyanAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cyan"
            android:label="@string/app_name"
